# OpenAI is optional. Leave this commented out to use free mode.
# Free mode uses local prompt enhancement and Pollinations image generation.
# NEVER commit a real key to Git. NEVER put this key in the Flutter app.

# OPENAI_API_KEY=sk-your-key-here
PORT=3000

# Which image model to use. gpt-image-1 or dall-e-3 both work with this code.
IMAGE_MODEL=gpt-image-1

# Which chat model to use for the "Enhance with AI" prompt-rewriting feature.
TEXT_MODEL=gpt-4o-mini
